          "apiKey": "test-key",
          "upstream": {
            "kind": "vendor"
          }
        },
        {
          "status": "requires_action"
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "UNKNOWN",
        "reason": "unrecognized interaction state"
      }
    },
